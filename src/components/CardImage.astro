---
interface Props {
	src: string;
	alt: string;
}

const { src, alt } = Astro.props;

const size = 192;
---

<img
	class="card-image"
	src={src}
	alt={alt}
	width={size}
	height={size}
	loading="lazy"
	decoding="async"
/>

<style>
	.card-image {
		display: block;
		width: 192px;
		height: 192px;
		object-fit: cover;
		border-radius: 8px;
		box-shadow: 0 4px 4px rgba(0, 0, 0, 0.25);
	}
</style>
