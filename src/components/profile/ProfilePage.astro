---
import CardDescription from '../CardDescription.astro';
import CollectionBadge from '../CollectionBadge.astro';
import CollectionTitle from '../CollectionTitle.astro';
import { UserOutlined } from '../icons/outlined';
import ProfileCollectionCard from './ProfileCollectionCard.astro';
import { resolveAssetImage } from '../../data';
import type { Collection } from '../../types/collection';
import type { Profile } from '../../types/profile';

interface Props {
	profile: Profile;
	collections: Collection[];
	pageGradient: string;
	avatarSrc: string;
}

const { profile, collections, pageGradient, avatarSrc } = Astro.props;

const borderColor = profile.settings.borderColor ?? '#f6f0e3';
const descriptionCardColor = profile.settings.descriptionCardColor ?? '#47776f';
const descriptionCardBorderColor =
	profile.settings.descriptionCardBorderColor ?? borderColor;

const collectionCards = collections.map((collection) => {
	const cover = resolveAssetImage(collection.image);
	const coverSrc = typeof cover === 'string' ? cover : cover.src;
	return { collection, coverSrc };
});
---

<section class="profile-page" style={`--page-gradient: ${pageGradient}`}>
	<div class="profile-page__header">
		<div class="profile-page__hero">
			<img
				class="profile-page__avatar"
				src={avatarSrc}
				alt=""
				width={192}
				height={192}
				loading="eager"
				decoding="async"
			/>
			<div class="profile-page__meta">
				<CollectionBadge label="Perfil" icon={UserOutlined} />
				<CollectionTitle title={profile.name} fontSize={36} />
				<p class="profile-page__username">{profile.username}</p>
				<CardDescription
					text={profile.bio}
					fontSize={14}
					backgroundColor={descriptionCardColor}
					borderColor={descriptionCardBorderColor}
				/>
			</div>
		</div>
	</div>

	<div class="profile-page__collections-wrap">
		<h2 class="profile-page__collections-title">Colecciones</h2>
		{
			collectionCards.length === 0 ? (
				<p class="profile-page__collections-empty">Este perfil aún no tiene colecciones.</p>
			) : (
				<ul class="profile-page__collections">
					{collectionCards.map(({ collection, coverSrc }) => (
						<li>
							<ProfileCollectionCard
								collection={collection}
								coverSrc={coverSrc}
								username={profile.username}
								borderColor={borderColor}
							/>
						</li>
					))}
				</ul>
			)
		}
	</div>
</section>

<style>
	.profile-page {
		min-height: calc(100vh - 74px - 280px);
		padding: 40px 24px 64px;
		background: var(--page-gradient);
		color: #f6f0e3;
	}

	.profile-page__header {
		max-width: 960px;
		margin: 0 auto 40px;
	}

	.profile-page__hero {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 32px;
	}

	.profile-page__avatar {
		width: 192px;
		height: 192px;
		border-radius: 50%;
		object-fit: cover;
		box-shadow: 0 4px 4px rgba(0, 0, 0, 0.25);
		flex-shrink: 0;
	}

	.profile-page__meta {
		display: flex;
		flex-direction: column;
		gap: 12px;
		flex: 1;
		min-width: 260px;
	}

	.profile-page__meta :global(.collection-title) {
		margin: 0;
	}

	.profile-page__username {
		margin: 0;
		font-size: 14px;
		opacity: 0.85;
	}

	.profile-page__collections-wrap {
		max-width: 960px;
		margin: 0 auto;
	}

	.profile-page__collections-title {
		margin: 0 0 20px;
		font-size: 24px;
		font-weight: 700;
		color: #f6f0e3;
	}

	.profile-page__collections {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.profile-page__collections-empty {
		margin: 0;
		font-size: 14px;
		opacity: 0.85;
	}

	@media (max-width: 768px) {
		.profile-page {
			padding: 24px 16px 48px;
		}

		.profile-page__hero {
			flex-direction: column;
			align-items: center;
			text-align: center;
		}

		.profile-page__meta :global(.collection-badge) {
			align-self: center;
		}
	}
</style>
