---
interface Props {
	text: string;
	fontSize?: number;
}

const { text, fontSize = 14 } = Astro.props;
---

<div class="card-description">
	<p>{text}</p>
</div>

<style define:vars={{ fontSize: `${fontSize}px` }}>
	.card-description {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 58px;
		padding: 4px 16px;
		border-radius: 8px;
		font-size: var(--fontSize);
		background-color: #47776f;
		color: #fff;
		border-left: 4px solid #df7f31;
	}

	.card-description p {
		margin: 0;
		padding: 0;
	}
</style>
