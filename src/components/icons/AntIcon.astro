---
/**
 * Renderiza iconos Ant Design. Usa variantes Outlined importadas desde `./outlined`.
 */
import type { IconDefinition } from '@ant-design/icons-svg/lib/types';
import { renderIconDefinitionToSVGElement } from '@ant-design/icons-svg/es/helpers';

interface Props {
	icon: IconDefinition;
	size?: number;
	class?: string;
}

const { icon, size = 16, class: className } = Astro.props;

const svg = renderIconDefinitionToSVGElement(icon, {
	extraSVGAttrs: {
		width: String(size),
		height: String(size),
		fill: 'currentColor',
		'aria-hidden': 'true',
	},
});
---

<span class:list={['ant-icon', className]} set:html={svg} />

<style>
	.ant-icon {
		display: inline-flex;
		line-height: 0;
	}
</style>
