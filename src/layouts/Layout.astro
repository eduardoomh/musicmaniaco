---
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteMeta from '../components/SiteMeta.astro';
import defaultShareImage from '../assets/music.maniaco-full-logo-negative.svg';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	canonicalPath?: string;
	ogType?: string;
	twitterCard?: 'summary' | 'summary_large_image';
	gradientStart?: string;
	gradientEnd?: string;
	gradientEndAt?: number;
}

const {
	title = 'Musicmaniaco colecciones musicales',
	description = 'Crea colecciones, documenta tu música y compártela con claridad.',
	gradientStart = '#05291d',
	gradientEnd = '#1d1e1e',
	gradientEndAt = 94,
	image,
	canonicalPath,
	ogType,
	twitterCard,
} = Astro.props;

const metaBase = Astro.site ?? Astro.url;
const canonical = canonicalPath ? new URL(canonicalPath, metaBase).href : undefined;
const shareImage = image ?? new URL(defaultShareImage.src, metaBase).href;
const faviconUrl = new URL('/favicon.ico', metaBase).href;

const chromeBackground = `linear-gradient(90deg, ${gradientStart} 0%, ${gradientEnd} ${gradientEndAt}%)`;
const htmlStyle = [
	`background:${chromeBackground}`,
	'color-scheme:dark',
	`--layout-chrome-start:${gradientStart}`,
	`--layout-chrome-end:${gradientEnd}`,
	`--layout-chrome-end-at:${gradientEndAt}%`,
].join(';');
---

<!doctype html>
<html lang="es" style={htmlStyle}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, viewport-fit=cover" />
		<meta name="theme-color" content={gradientStart} />
		<meta name="theme-color" content={gradientStart} media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content={gradientStart} media="(prefers-color-scheme: dark)" />
		<meta name="color-scheme" content="dark" />
		<link rel="icon" href={faviconUrl} sizes="any" type="image/x-icon" />
		<link rel="shortcut icon" href={faviconUrl} type="image/x-icon" />
		<link rel="apple-touch-icon" href={faviconUrl} />
		<title>{title}</title>
		<SiteMeta
			title={title}
			description={description}
			image={shareImage}
			canonical={canonical}
			ogType={ogType}
			twitterCard={twitterCard}
		/>
		<Font cssVariable="--font-inter" preload />
	</head>
	<body>
		<SiteHeader gradientStart={gradientStart} gradientEnd={gradientEnd} gradientEndAt={gradientEndAt} />
		<slot />
		<Footer gradientStart={gradientStart} gradientEnd={gradientEnd} gradientEndAt={gradientEndAt} />
	</body>
</html>

<style is:global>
	/* html/body no reciben scope de Astro; el fondo del chrome va en style inline en <html> */
	html {
		margin: 0;
		min-height: 100%;
	}

	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		font-family: var(--font-inter);
		background-color: #ffffff;
		isolation: isolate;
	}

	@supports (-webkit-touch-callout: none) {
		html,
		body {
			min-height: -webkit-fill-available;
		}
	}
</style>
